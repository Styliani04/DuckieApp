<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical" >

    <Button
        android:id="@+id/btnAddStore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Προσθήκη Καταστήματος"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnUpdateStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Αλλαγή Αποθέματος"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Προσθήκη Νέου Προϊόντος"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnDeleteProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Διαγραφή Προϊόντος"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnShowSales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Εμφάνιση Συνολικών Πωλήσεων"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Έξοδος" />

</LinearLayout>
