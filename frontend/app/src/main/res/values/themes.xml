<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Duckie" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/custom_orange</item>
        <item name="colorPrimaryVariant">@color/custom_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>


        <!-- Secondary brand color-->
        <item name="colorSecondary">@color/custom_orange_dark</item>
        <item name="colorSecondaryVariant">@color/custom_orange_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Default button -->
        <item name="buttonStyle">@style/OrangeButton</item>
    </style>

    <!-- Default button style -->
    <style name="OrangeButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/custom_orange</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
